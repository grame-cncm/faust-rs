#
# Build the genuine C++ reference impulse responses (the test oracle).
#
# Each reference is the full 4-pass protocol (impulse + random-split block +
# polyphonic 4 voices + polyphonic 1 voice = 60000 frames) produced by the
# reference C++ Faust compiler in `controlTools.h::runDSP/runPolyDSP`.
#
# Run from this directory:  make -f Make.ref reference
#

include common.mk

# Only DSPs accepted by the configured C++ Faust can have a differential
# reference. `reference` first refreshes the manifest, then invokes a fresh
# make process so this list is computed from that manifest.
reffiles := $(patsubst $(dspdir)/%.dsp,$(refdir)/%.ir,$(call cpp_oracle_dspfiles))

.PHONY: reference reference-checked reference-report reference-report-checked FORCE
.DELETE_ON_ERROR:

# The recursive invocation is intentional: included makefiles are read during
# parsing, whereas the preflight manifest is produced during this invocation.
# A second parse makes its accepted/rejected DSP list available to `reffiles`
# and to all normal backend sub-makes.
reference: $(CPP_ORACLE_MANIFEST)
	$(MAKE) -f Make.ref reference-checked

reference-checked: $(COMPARE) $(refdir)/.dir build/ref/.dir $(reffiles)

reference-report: $(CPP_ORACLE_MANIFEST)
	$(MAKE) -f Make.ref reference-report-checked

reference-report-checked:
	@echo "C++ oracle supported: $(words $(CPP_ORACLE_SUPPORTED)) DSP(s)"
	@echo "C++ oracle unsupported: $(words $(CPP_ORACLE_UNSUPPORTED)) DSP(s)"
	@if test -n "$(strip $(CPP_ORACLE_UNSUPPORTED))"; then \
		printf '%s\n' "  $(CPP_ORACLE_UNSUPPORTED)"; \
		echo "  diagnostics: $(CPP_ORACLE_LOG_DIR)/<dsp>.log"; \
	fi

# Recheck the C++ compiler identity and the selected corpus on every invocation
# without perturbing the stamp when they are unchanged. This makes switching
# `FAUST_CPP`, its version, include paths, architecture, or `dspfiles` refresh
# the manifest instead of reusing an oracle classification from another setup.
FORCE:

$(CPP_ORACLE_CONFIG): FORCE
	@mkdir -p $(dir $@)
	@tmp="$@.tmp"; \
	{ \
		printf 'FAUST_CPP=%s\n' '$(FAUST_CPP)'; \
		$(FAUST_CPP) --version 2>&1; \
		printf 'IMPULSE_ARCH=%s\nFAUSTLIBS=%s\ndspdir=%s\ndspfiles=%s\n' \
			'$(IMPULSE_ARCH)' '$(FAUSTLIBS)' '$(dspdir)' '$(dspfiles)'; \
	} > "$$tmp"; \
	if test -r "$@" && cmp -s "$$tmp" "$@"; then rm -f "$$tmp"; else mv "$$tmp" "$@"; fi

# Compile only through C++ Faust here; native C++ compilation and execution
# remain the reference target's responsibility. A missing compiler or a setup
# that accepts no DSP is a harness error, not a reason to skip the corpus.
$(CPP_ORACLE_MANIFEST): $(CPP_ORACLE_CONFIG) $(dspfiles) Make.ref common.mk known.mk
	@set -eu; \
	$(FAUST_CPP) --version >/dev/null 2>&1 || { \
		echo "C++ Faust compiler is unavailable: $(FAUST_CPP)" >&2; exit 2; \
	}; \
	mkdir -p $(dir $@) $(CPP_ORACLE_LOG_DIR); \
	tmp="$@.tmp"; supported=''; unsupported=''; \
	for dsp in $(dspfiles); do \
		name=$${dsp##*/}; name=$${name%.dsp}; \
		log="$(CPP_ORACLE_LOG_DIR)/$$name.log"; \
		if $(FAUST_CPP) -lang cpp -double -i -a $(IMPULSE_ARCH) -I $(dspdir) -I $(FAUSTLIBS) "$$dsp" -o /dev/null >"$$log" 2>&1; then \
			supported="$$supported $$name"; rm -f "$$log"; \
		else \
			unsupported="$$unsupported $$name"; \
		fi; \
	done; \
	if test -z "$$supported"; then \
		echo "C++ Faust accepted no DSP; inspect $(CPP_ORACLE_LOG_DIR)" >&2; exit 2; \
	fi; \
	{ \
		echo '# Generated by Make.ref; do not edit.'; \
		printf 'CPP_ORACLE_SUPPORTED :=%s\n' "$$supported"; \
		printf 'CPP_ORACLE_UNSUPPORTED :=%s\n' "$$unsupported"; \
	} > "$$tmp"; \
	mv "$$tmp" "$@"; \
	echo "C++ oracle preflight: $$(printf '%s\n' "$$supported" | wc -w | tr -d ' ') supported, $$(printf '%s\n' "$$unsupported" | wc -w | tr -d ' ') unsupported"

$(refdir)/.dir:
	mkdir -p $(refdir)
	touch $@

build/ref/.dir:
	mkdir -p build/ref
	touch $@

$(COMPARE): tools/filesCompare.cpp
	$(CXX) -O2 -std=c++11 $< -o $@

# Compile the DSP with the reference C++ compiler + 4-pass architecture, build
# the native binary, then run it to capture the 60000-frame response.
$(refdir)/%.ir: $(dspdir)/%.dsp | $(refdir)/.dir build/ref/.dir
	$(FAUST_CPP) -lang cpp -double -i -a $(IMPULSE_ARCH) -I $(dspdir) -I $(FAUSTLIBS) $< -o build/ref/$*.cpp
	$(CXX) $(CXXFLAGS) build/ref/$*.cpp -o build/ref/$*
	./build/ref/$* -n $(NFRAMES) > $@
	@echo "reference $*"
