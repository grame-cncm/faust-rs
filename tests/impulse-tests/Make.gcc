#
# Test a native faust-rs backend (C or C++) against the reference.
#
# faust-rs generates C/C++ source, it is wrapped in the *same* 4-pass impulse
# architecture as the reference, compiled natively and run. Because faust-rs's
# generated class implements the standard Faust `dsp` interface (clone(),
# buildUserInterface(), compute()...), it runs the full polyphonic protocol and
# the produced 60000-frame `.ir` is compared with the reference with no -part.
#
# Run from this directory, e.g.:
#   make -f Make.gcc outdir=cpp lang=cpp
#   make -f Make.gcc outdir=c   lang=c
#

include common.mk

outdir ?= cpp
lang   ?= cpp

# C output is wrapped by a C-specific impulse architecture (see common.mk).
ifeq ($(lang),c)
ARCH := $(IMPULSE_ARCH_C)
else
ARCH := $(IMPULSE_ARCH)
endif

# Build everything except the documented known failures for this backend.
allnames  := $(dspfiles:$(dspdir)/%.dsp=%)
testnames := $(filter-out $(call known_fail_for,$(outdir)),$(allnames))
listfiles := $(testnames:%=ir/$(outdir)/%.ir)

.PHONY: all
.DELETE_ON_ERROR:

all: $(COMPARE) ir/$(outdir)/.dir build/$(outdir)/.dir $(listfiles)

ir/$(outdir)/.dir:
	mkdir -p ir/$(outdir)
	touch $@

build/$(outdir)/.dir:
	mkdir -p build/$(outdir)
	touch $@

$(COMPARE): tools/filesCompare.cpp
	$(CXX) -O2 -std=c++11 $< -o $@

# How the produced response is checked against the reference.
#
# The default is a full equality check: this architecture emits all four
# reference passes, so the two files have the same length and every frame must
# agree.
#
# The RAD lane overrides it, because there the reference comes from the
# faust-rs interpreter and covers the scalar impulse pass only, while this
# architecture still emits four passes. `filesCompare` iterates over the length
# of its *first* argument, so the shorter file has to come first — that is what
# `-part` means. The check is then "every reference frame matches the produced
# output at the same index", which is the strongest statement a 15000-frame
# reference supports.
COMPARE_ARGS ?= $@ $(refdir)/$*.ir $(call dsp_precision,$*)

ir/$(outdir)/%.ir: $(dspdir)/%.dsp $(refdir)/%.ir | ir/$(outdir)/.dir build/$(outdir)/.dir
	$(FAUST_RS) -lang $(lang) -double $(COMPILER_OPTS) -a $(ARCH) -I $(dspdir) -I $(FAUSTLIBS) $< -o build/$(outdir)/$*.cpp
	$(CXX) $(CXXFLAGS) build/$(outdir)/$*.cpp -o build/$(outdir)/$*
	./build/$(outdir)/$* -n $(NFRAMES) > $@
	$(COMPARE) $(COMPARE_ARGS) || (rm -f $@; false)
